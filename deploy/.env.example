KINKUDOS_HOSTNAME=kinkudos.example.com
# Generic installations omit this. The Hostinger installer writes a stable,
# versioned profile marker here and in ../install-profile.
# KINKUDOS_INSTALL_PROFILE=hostinger-caddy-v1
KINKUDOS_UID=1000
KINKUDOS_GID=1000
KINKUDOS_DEFAULT_LANGUAGE=en
KINKUDOS_PROXY_MODE=host
# Used by Traefik, Nginx Proxy Manager, or another container proxy.
KINKUDOS_PROXY_NETWORK=web
# Forwarded headers are accepted only from these proxy networks.
# Guided bootstrap/upgrade sets this from the proxy mode (loopback for host
# Nginx/Caddy; Docker network CIDR for Traefik/NPM). Leave as-is to keep an
# explicit operator value. Application fallback is loopback only.
KINKUDOS_TRUSTED_PROXIES=127.0.0.0/8,::1/128

# Email password reset is disabled by default.
# Run ./configure-email.sh or enter your SMTP provider settings.
KINKUDOS_EMAIL_ENABLED=false
# Allow SMTP verify/send to private or LAN hosts (default off).
# KINKUDOS_SMTP_ALLOW_PRIVATE_DESTINATIONS=false
# KINKUDOS_EMAIL_HOST=smtp.example.com
# KINKUDOS_EMAIL_PORT=587
# KINKUDOS_EMAIL_USE_TLS=true
# KINKUDOS_EMAIL_USE_SSL=false
# KINKUDOS_EMAIL_HOST_USER=smtp-user
# KINKUDOS_DEFAULT_FROM_EMAIL=KinKudos <noreply@example.com>
# Optional address that receives notifications about saved feedback.
# KINKUDOS_FEEDBACK_EMAIL=feedback@example.com
