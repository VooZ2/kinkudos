# Copy this file to ../secrets/backup/restic.env and set chmod 600.
# Any local or remote repository supported by restic can be used.
RESTIC_REPOSITORY=REPLACE_WITH_REPOSITORY

# Backblaze B2 is recommended through its S3-compatible API.
# Example:
# RESTIC_REPOSITORY=s3:https://s3.eu-central-003.backblazeb2.com/my-bucket/kinkudos
# An S3-compatible repository requires these values:
# AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
# AWS_DEFAULT_REGION=REPLACE_WITH_REGION
