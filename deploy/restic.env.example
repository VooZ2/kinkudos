# Copy this file to ../secrets/restic.env and set chmod 600.
# Any local or remote repository supported by restic can be used.
RESTIC_REPOSITORY=REPLACE_WITH_REPOSITORY

# An S3-compatible repository will usually require these values:
# AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY
